<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" alignment="CENTER" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.nicolas.pokemonbasico.controller.PokemonController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- FORMULARIO PARA AGREGAR NUEVO ELEMENTO -->
    <HBox spacing="8.0" alignment="CENTER">
        <TextField fx:id="txtId" prefWidth="60.0" promptText="ID" />
        <TextField fx:id="txtNombre" promptText="Nombre" HBox.hgrow="ALWAYS" />
        <TextField fx:id="txtTipo" promptText="Tipo" HBox.hgrow="ALWAYS" />
        <Button text="Guardar" onAction="#onGuardarClick"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white;" />
    </HBox>

    <!-- TABLEVIEW BÁSICO -->
    <TableView fx:id="tableView" prefHeight="300.0" prefWidth="450.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre (Doble clic)" />
            <TableColumn fx:id="colTipo" prefWidth="170.0" text="Tipo" />
        </columns>
    </TableView>

    <!-- BOTÓN PARA ELIMINAR -->
    <Button text="Eliminar Seleccionado" onAction="#onEliminarClick"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />

</VBox>
