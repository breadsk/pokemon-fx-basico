<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="cl.nicolas.pokemonbasico.controller.Controller">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15"/>
    </padding>

    <!--TABLEVIEW BASICO-->
    <TableView fx:id="tableView" prefHeight="300.0" prefWidth="400.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre (Doble clic)" />
            <TableColumn fx:id="colTipo" prefWidth="140.0" text="Tipos" />
        </columns>
    </TableView>

    <!-- BOTON PARA ELIMINAR -->
    <Button
            text="Eliminar Seleccionado"
            onAction="#onEliminarClick"
            style="
                -fx-background-color: #e74c3c;
                -fx-text-fill: white;" />
</VBox>
